# Postgres (Supabase) connection string — replace <PROJECT_REF>, <PASSWORD>, <REGION> with your project's values (use the pooled connection for Prisma)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Single-till front-desk credentials — replace with real, non-default values before deploying
ADMIN_USERNAME="<choose-a-username>"
ADMIN_PASSWORD="<choose-a-strong-password>"

# Secret used to sign the admin login JWT (HS256) — generate a long random string and keep it secret
JWT_SECRET="<generate-a-long-random-secret>"